@startuml 52_s6_c4_contexto_fastapi
' Fuente original: pmv_fastapi/docs/diagramas/C4_contexto.puml
' Adaptada a diagramas/src/ sin includes remotos
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11

title C4 · Nivel 1 — Diagrama de Contexto del PMV FastAPI

actor "Personal de salud\n(Enfermera/técnica)" as enf #DCE9F7
actor "Agente comunitario\nde salud" as acs #DCE9F7
actor "Gestión territorial\n(Microred)" as mic #DCE9F7

rectangle "Sistema de Detección Temprana de Anemia Infantil" as sis #EAF2FB
note right of sis
  Registro nominal, validación clínica,
  seguimiento y reportes.
  PMV = Incremento 1
end note

rectangle "HIS / MINSA" as his #F0F0F0
note right of his
  Sistema oficial de registro
  (futuro, INC-1 fuera de alcance)
end note

rectangle "WhatsApp Business API" as wa #F0F0F0
note right of wa
  Recordatorios a familias (INC-4)
end note

actor "Familia / tutor" as fam #F0F0F0

enf --> sis : "Registra y consulta\nexpedientes (HTTPS)"
acs --> sis : "Registra visitas\n(INC-3, offline)"
mic --> sis : "Consulta reportes\ne indicadores (HTTPS)"

sis --> his : "Exporta/consulta\ndatos autorizados\n(API futura)"
sis --> wa : "Envía recordatorios\n(INC-4, HTTPS)"
wa --> fam : "Mensajes\nWhatsApp"

note bottom of sis
  Fuente: pmv_fastapi/docs/diagramas/C4_contexto.puml
  coordinacion/s6/DATOS_PMV_FASTAPI.md §3
end note

@enduml
