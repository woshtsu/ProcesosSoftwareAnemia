# Primera etapa: Supabase Auth; DATABASE_URL aún puede ser SQLite.
AUTH_MODE=supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar
# Solo para desarrollo en http://127.0.0.1; en HTTPS usar true.
AUTH_COOKIE_SECURE=false
DATABASE_URL=sqlite:///./datos/anemia.db

# Inicio local: uvicorn app.main:crear_app --factory --env-file .env --port 8000
# Demo histórica sin autenticación: AUTH_MODE=demo (no usar en un despliegue público).
