# Primera etapa: Supabase Auth; DATABASE_URL aún puede ser SQLite.
AUTH_MODE=supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar
# Solo para desarrollo en http://127.0.0.1; en HTTPS usar true.
AUTH_COOKIE_SECURE=false
DATABASE_URL=sqlite:///./datos/anemia.db

# Inicio local: uvicorn app.main:crear_app --factory --env-file .env --port 8000
# Demo histórica sin autenticación: AUTH_MODE=demo (no usar en un despliegue público).

# Incremento 4: recordatorios por mensajería. Todas las variables son opcionales y se dejan vacías por defecto:
# sin WHATSAPP_TOKEN y WHATSAPP_PHONE_NUMBER_ID el sistema funciona en modo simulado (no sale ningún mensaje).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que Meta devuelve al registrar el webhook (GET /api/notificaciones/whatsapp/webhook).
WHATSAPP_VERIFY_TOKEN=
# Secreto de la aplicación de Meta para validar la firma X-Hub-Signature-256; configurarlo siempre en producción.
WHATSAPP_APP_SECRET=
# Opcionales: plantilla aprobada (por defecto recordatorio_control), idioma (es) y versión de la Graph API (v21.0).
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=
WHATSAPP_API_VERSION=
# Respaldo por SMS si WhatsApp falla (proveedor HTTP genérico; sin URL no se agrega el respaldo).
SMS_API_URL=
SMS_API_TOKEN=
SMS_REMITENTE=
